# LLM gateway (OpenAI-compatible)
OPENAI_BASE_URL=https://gateway.ai.skyformit.com/v1
OPENAI_API_KEY=replace-me
DEFAULT_FAST_MODEL=fast
DEFAULT_SMART_MODEL=smart
POLISH_MODEL=claude-haiku-5-5
# mock | gateway  (tests and keyless sessions use mock; mock is refused when APP_ENV=production)
LLM_PROVIDER=mock

# Storage
DATABASE_URL=sqlite:///./data/poc-studio.sqlite

# GitHub (fine-grained token: repo create, contents, issues) — publish is mocked unless GITHUB_MODE=live
GITHUB_TOKEN=replace-me
GITHUB_MODE=mock

# API port
PORT=8000
APP_ENV=development
# Per-run paid-token budget in USD
RUN_BUDGET_USD=0.05

# Monthly paid-token cap in USD
MONTHLY_CAP_USD=5
# Set to 1 to allow live (paid) evaluation runs
EVAL_LIVE=0
# Days to keep run artifacts before cleanup
RETENTION_DAYS=0
# Optional override of the SQLite location (the plain DATABASE_URL name is not read)
# POC_DATABASE_URL=sqlite:///./data/poc-studio.sqlite
